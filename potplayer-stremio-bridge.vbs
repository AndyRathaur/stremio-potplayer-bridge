' PotPlayer Stremio Protocol Bridge (VBScript Fallback)
' Intercepts vlc:// URLs and external player calls generated by Stremio, routing them directly to PotPlayer.

Option Explicit

Dim args, rawUrl, streamUrl, i, arg, finalArgs
Dim fso, shell, exePath, regVal

Set args = WScript.Arguments
If args.Count = 0 Then
    WScript.Quit 0
End If

Set fso = CreateObject("Scripting.FileSystemObject")
Set shell = CreateObject("WScript.Shell")

' 1. Locate PotPlayer Executable
exePath = ""
Dim candidates
candidates = Array( _
    "C:\Program Files\DAUM\PotPlayer\PotPlayerMini64.exe", _
    "C:\Program Files\DAUM\PotPlayer\PotPlayer64.exe", _
    "C:\Program Files (x86)\DAUM\PotPlayer\PotPlayerMini.exe", _
    "C:\Program Files (x86)\DAUM\PotPlayer\PotPlayer.exe" _
)

For i = 0 To UBound(candidates)
    If fso.FileExists(candidates(i)) Then
        exePath = candidates(i)
        Exit For
    End If
Next

If exePath = "" Then
    On Error Resume Next
    regVal = shell.RegRead("HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\PotPlayerMini64.exe\")
    If Err.Number = 0 And regVal <> "" Then
        regVal = Replace(regVal, """", "")
        If fso.FileExists(regVal) Then exePath = regVal
    End If
    Err.Clear
    On Error GoTo 0
End If

If exePath = "" Then
    MsgBox "PotPlayer executable could not be found. Please ensure PotPlayer is installed.", vbCritical, "Stremio PotPlayer Bridge"
    WScript.Quit 1
End If

' 2. Parse & sanitize arguments
finalArgs = "/current"

For i = 0 To args.Count - 1
    arg = Trim(args(i))
    
    ' Strip POSIX option delimiter
    If arg = "--" Or arg = "-" Then
        ' Ignore delimiter
    ElseIf LCase(Left(arg, 6)) = "vlc://" Then
        streamUrl = Mid(arg, 7)
        finalArgs = finalArgs & " """ & streamUrl & """"
    ElseIf LCase(Left(arg, 12)) = "potplayer://" Then
        streamUrl = Mid(arg, 13)
        finalArgs = finalArgs & " """ & streamUrl & """"
    ElseIf LCase(Left(arg, 11)) = "--sub-file=" Then
        finalArgs = finalArgs & " /sub=""" & Mid(arg, 12) & """"
    ElseIf LCase(Left(arg, 13)) = "--start-time=" Then
        finalArgs = finalArgs & " /seek=" & Mid(arg, 14)
    ElseIf Left(arg, 2) = "--" Or Left(arg, 1) = "-" Then
        ' Ignore other VLC-specific flags
    Else
        ' File path or stream URL
        finalArgs = finalArgs & " """ & arg & """"
    End If
Next

' 3. Launch PotPlayer
shell.Run """" & exePath & """ " & finalArgs, 1, False
